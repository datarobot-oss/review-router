{
  "name": "review-router",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that routes code reviews based on CODEOWNERS",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "test": "jest --coverage",
    "lint": "eslint src/ __tests__/",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts' '*.json' '*.md'",
    "format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts' '*.json' '*.md'",
    "all": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datarobot-oss/review-router.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@slack/web-api": "^8.0.0",
    "ajv": "^8.20.0",
    "codeowners-utils": "^1.0.2",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
